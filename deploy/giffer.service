[Unit]
Description=Giffer Reborn classroom static server
# Wait for the network so the boot-time "git pull" in serve.sh can reach GitHub.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __USER__ and __REPO_DIR__ are filled in by deploy/setup.sh.
User=__USER__
WorkingDirectory=__REPO_DIR__
ExecStart=__REPO_DIR__/deploy/serve.sh
Environment=GIFFER_PORT=80
# Let a non-root service bind port 80 (so the URL is a bare IP, no ":8000").
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Keep it up: restart if it ever crashes.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
